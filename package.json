{
  "description": "Thanksleuser — Outdoor Event Organizer & Community Banda Aceh: landing page + booking engine open trip (situs statis, tanpa backend; booking & pre-order dikirim sebagai pesan WhatsApp ke admin).",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "html-validate": "^11.21.1",
    "wrangler": "^3.100.0"
  },
  "name": "thanksleuser",
  "private": true,
  "scripts": {
    "deploy": "npx wrangler pages deploy . --project-name=thanksleuser",
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "screenshots": "node scripts/screenshot.mjs",
    "sweep": "python3 scripts/advisory-sweep.py",
    "test": "npx playwright test e2e/smoke.spec.js",
    "validate": "node scripts/check-links.mjs && npx html-validate index.html",
    "make-video": "node scripts/make-video.mjs"
  },
  "version": "1.1.0",
  "type": "module"
}